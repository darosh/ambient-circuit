                                                                        "numoutlets": 0
                                                                    }
                                                                },
                                                                {
                                                                    "box": {
                                                                        "maxclass": "comment",
                                                                        "text": "A resonant filter is a band-pass filter that passes frequencies in a specified region and attenuates frequencies outside that region. It requires three parameter values: center (resonated) frequency, input gain, and a resonance quality factor (Q). The Q determines the bandwidth of the passed region around the center frequency.",
                                                                        "linecount": 3,
                                                                        "patching_rect": [ 40.0, 60.0, 600.0, 50.0 ],
                                                                        "background": 1,
                                                                        "numinlets": 1,
                                                                        "id": "obj-6",
                                                                        "numoutlets": 0
                                                                    }
