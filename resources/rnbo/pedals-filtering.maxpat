                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 295.0, 480.0, 53.0, 21.0 ],
                                    "text": "Cutoff R"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "id": "obj-17",
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 355.0, 351.0, 38.0, 21.0 ],
                                    "text": "[0. 1.]"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "id": "obj-44",
                                    "linecount": 4,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 670.0, 640.0, 250.0, 64.0 ],
                                    "text": "Also notice the slight amplitude boost added to the filtered signals, needed to compensate for some energy loss perceived as the Q (resonance) factor of the filter is increased."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "id": "obj-104",
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 390.0, 760.0, 20.0, 21.0 ],
                                    "text": "%"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
