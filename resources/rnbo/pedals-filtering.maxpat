                                    "id": "obj-119",
                                    "linecount": 3,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 491.0, 708.0, 92.0, 50.0 ],
                                    "text": "Adjusts a boost factor from 0 dB to +12 dB"
                                }
                            },
                            {
