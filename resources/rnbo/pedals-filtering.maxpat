                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 483.0, 851.0, 70.0, 21.0 ],
                                    "text": "10 ms ramp"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
