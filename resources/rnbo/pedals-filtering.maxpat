                            },
                            {
                                "box": {
                                    "background": 1,
                                    "id": "obj-27",
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 77.0, 140.0, 79.0, 21.0 ],
                                    "text": "Side-chaining"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "id": "obj-125",
                                    "linecount": 4,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 670.0, 710.0, 250.0, 64.0 ],
                                    "text": "Finally, as the filtering induces a volume dropdown, a signal-boost is applied to the filtered sound, followed by some peak limiter also implemented in Gen."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
