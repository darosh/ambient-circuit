                                                                },
                                                                {
                                                                    "box": {
                                                                        "maxclass": "comment",
                                                                        "text": "Equivalent resonant filter formula  expressed in GenExpr, the internal language used by gen patchers and by the Gen codebox object:",
                                                                        "linecount": 4,
                                                                        "patching_rect": [ 410.0, 360.0, 200.0, 64.0 ],
                                                                        "background": 1,
                                                                        "numinlets": 1,
