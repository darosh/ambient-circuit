                                                                    }
                                                                },
                                                                {
                                                                    "box": {
                                                                        "maxclass": "comment",
                                                                        "text": "cf = in1;\ngain = in2;\nQ = in3;\n\nomega = cf * twopi/samplerate;\nsn = sin(omega);\ncs = cos(omega);\nalpha = sn * 0.5/Q;\nb0 = 1./(1. + alpha);\n\na0 = alpha * gain * Q * b0;\na2 = -alpha * gain * Q * b0;\nb1 = -2. * cs * b0;\nb2 = (1. - alpha) * b0;\na1 = 0.;\n\nout1 = a0;\nout2 = a1;\nout3 = a2;\nout4 = b1;\nout5 = b2;",
                                                                        "linecount": 21,
                                                                        "patching_rect": [ 410.0, 430.0, 174.0, 309.0 ],
