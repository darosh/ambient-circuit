                                                {
                                                    "box": {
                                                        "maxclass": "comment",
                                                        "text": "Two pole, two zero filter",
                                                        "linecount": 2,
                                                        "patching_rect": [ 290.0, 520.0, 90.0, 35.0 ],
                                                        "background": 1,
                                                        "numinlets": 1,
                                                        "id": "obj-19",
                                                        "numoutlets": 0
                                                    }
                                                },
                                                {
                                                    "box": {
                                                        "maxclass": "comment",
                                                        "text": "Equivalent band-pass filter formula  expressed in GenExpr, the internal language used by gen patchers and by the Gen codebox object:",
                                                        "linecount": 4,
                                                        "patching_rect": [ 410.0, 270.0, 200.0, 64.0 ],
                                                        "background": 1,
                                                        "numinlets": 1,
                                                        "id": "obj-30",
                                                        "numoutlets": 0
                                                    }
                                                },
                                                {
                                                    "box": {
                                                        "maxclass": "comment",
                                                        "text": "cf = in1;\nQ = in2;\n\nomega = cf * twopi/samplerate;\nsn = sin(omega);\ncs = cos(omega);\nalpha = sn * 0.5/Q;\n\nb0 = 1./(1. + alpha);\na0 = alpha * b0;\na1 = 0.;\na2 = -alpha * b0;\nb1 = -2. * cs * b0;\nb2 = (1. - alpha) * b0;\n\nout1 = a0;\nout2 = a1;\nout3 = a2;\nout4 = b1;\nout5 = b2;",
                                                        "linecount": 20,
                                                        "patching_rect": [ 410.0, 340.0, 174.0, 294.0 ],
                                                        "background": 1,
                                                        "numinlets": 1,
                                                        "id": "obj-48",
                                                        "numoutlets": 0
                                                    }
