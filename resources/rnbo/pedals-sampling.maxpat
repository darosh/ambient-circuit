                                        },
                                        "textcolor": {
                                            "expression": "themecolor.theme_textcolor_inverse"
                                        }
                                    },
                                    "text": "Copy",
                                    "textcolor": [ 0.9, 0.9, 0.9, 1.0 ]
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "bgcolor": [ 0.125, 0.125, 0.125, 1.0 ],
                                    "fontface": 1,
                                    "fontsize": 10.0,
                                    "hint": "Alt-click (Mac) / opt-click (PC) on an object box while the patcher is unlocked to view an object's help file.",
                                    "id": "obj-118",
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 1080.0, 920.0, 30.0, 18.0 ],
                                    "saved_attribute_attributes": {
                                        "bgcolor": {
                                            "expression": "themecolor.theme_bgcolor"
                                        },
                                        "textcolor": {
                                            "expression": "themecolor.theme_textcolor_inverse"
                                        }
                                    },
                                    "text": "Help",
                                    "textcolor": [ 0.9, 0.9, 0.9, 1.0 ]
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "fontname": "Lato",
                                    "fontsize": 10.0,
                                    "id": "obj-119",
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 1080.0, 940.0, 111.0, 18.0 ],
                                    "text": "manuel@cycling74.com"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-114",
                                    "linecount": 7,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 1050.0, 370.0, 255.0, 107.0 ],
                                    "text": "An attack detection tool can be engaged to auto-trigger successive freezes according to the audio input. An \"autodel\" delay can also be used, so that the recording occurs later after each detection of attack, in order to avoid the presence of harsh transients in the frozen sound, such as those produced by a guitar pick."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-100",
                                    "linecount": 4,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 1050.0, 780.0, 250.0, 64.0 ],
                                    "text": "Additionally, the overall pitch can be changed by modifying the rate of the reading phasor, and EQ is applied at the output to fine-tune the timbre of the synthesis."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-90",
                                    "linecount": 5,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 1050.0, 700.0, 240.0, 78.0 ],
                                    "text": "To help the granular sound that might be harsh to hear, different local jitterings are applied to each voice: position in the sample (which slightly varies the pitch), amplitude and panning."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-82",
                                    "linecount": 8,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 1050.0, 580.0, 250.0, 122.0 ],
                                    "text": "Each of the sampler voices has a shifting of the phase that drives the sample player, so the same portion of sample is read at different times by each player. Thanks to the same Hanning amplitude window, transitions (or crossfades) between each \"grain\" of sound are smoothened, and all grains form together a continuous global sound."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-31",
                                    "linecount": 6,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 1050.0, 480.0, 261.0, 93.0 ],
                                    "text": "The sample player is a RNBO abstraction patcher (Rnbo-Freezer-Voice~) which is loaded 8 times, according to the @polyphony attribute in the patcher box. This mechanism instantiates 8 copies of the abstraction, which can be manipulated separately."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-20",
                                    "linecount": 4,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 1050.0, 300.0, 240.0, 64.0 ],
                                    "text": "When the freezing is stopped, a fade-out ramp is triggered. Adjusting the fade time allows smooth transitions between successive freezes."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-4",
                                    "linecount": 6,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 1050.0, 200.0, 242.0, 93.0 ],
                                    "text": "FreezeA and FreezeB players are phasor-drive sample players, and play constantly. When a new recording is started in FreezeA or FreezeB, it is immediately monitored, with a fade-in ramp passing through a soft Hanning amplitude window."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "id": "obj-3",
                                    "linecount": 2,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 930.0, 794.0, 100.0, 35.0 ],
                                    "text": "Enables/disables the direct sound"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-6",
                                    "linecount": 2,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 600.0, 70.0, 170.0, 35.0 ],
                                    "text": "Sets a crossfade time when switching sample players"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-128",
                                    "linecount": 4,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 337.75, 34.0, 142.5, 64.0 ],
                                    "text": "Inserts a delay between detected attack and freezing (avoid potential harsh transients) "
                                }
                            },
