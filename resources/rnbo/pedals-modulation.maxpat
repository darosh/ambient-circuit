                                                }
                                            },
                                            {
                                                "box": {
                                                    "background": 1,
                                                    "id": "obj-5",
                                                    "linecount": 3,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 150.0, 550.0, 110.0, 50.0 ],
                                                    "text": "Single-pole lowpass filter used as  high-pass filter"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "background": 1,
                                                    "id": "obj-8",
                                                    "linecount": 6,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 50.0, 40.0, 413.0, 93.0 ],
                                                    "text": "\"Soft\" arc-tangent non-linear function applied to the input signal. As the input gain is increased, the input signal becomes closer to a square wave. An amplitude attenuation is then applied to the output of the atan~ object, so that the energy gained in the process is compensated in terms of perceived volume. Additionally, the low-end signals are attenuated as the drive amount increases, in order to producie distortion that sounds \"thinner\"."
                                                }
