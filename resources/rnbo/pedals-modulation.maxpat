                                                    "fgcolor": [ 0.999999284744263, 0.999974429607391, 0.999991297721863, 1.0 ],
                                                    "gridcolor": [ 0.505882352941176, 0.564705882352941, 0.666666666666667, 0.25 ],
                                                    "id": "obj-23",
                                                    "maxclass": "scope~",
