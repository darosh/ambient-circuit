                                                    "numoutlets": 0,
                                                    "patching_rect": [ 280.0, 340.0, 50.0, 30.0 ],
                                                    "rnbo_classname": "scope~",
                                                    "rnbo_extra_attributes": {
                                                        "bufsize": 128.0,
                                                        "calccount": 256.0
