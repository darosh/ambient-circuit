                                    "numoutlets": 0,
                                    "patching_rect": [ 790.0, 530.0, 181.0, 50.0 ],
                                    "text": "Finally, all signals pass through a second level limiter and a Dry/Wet balance unit."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-111",
