                                                }
                                            },
                                            {
                                                "box": {
                                                    "background": 1,
                                                    "fontface": 0,
                                                    "id": "obj-153",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 650.0, 202.0, 68.0, 21.0 ],
                                                    "text": "Delay2 L/R"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "background": 1,
                                                    "fontface": 0,
                                                    "id": "obj-154",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 510.0, 202.0, 56.0, 21.0 ],
                                                    "text": "Delay1 R"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "background": 1,
