                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 0,
                                    "id": "obj-79",
                                    "linecount": 5,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 690.0, 530.0, 228.0, 78.0 ],
                                    "text": "Additionally, a spectrum filtering step is applied to avoid artifacts when the delay time is close to 0 ms—i.e., when the input signal and the modulated signal are almost identical."
                                }
