                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 350.0, 500.0, 64.0, 35.0 ],
                                    "text": "Threshold * knee"
                                }
                            },
