                                    "numoutlets": 0,
                                    "patching_rect": [ 560.0, 142.0, 182.0, 93.0 ],
                                    "text": "FullBandBoost~ has a simple global (up to) +18 dB gain boost, while BandLimitedBoost~ offers a (up to) +18 dB gain boost at  adjustable frequency and width, using a peaknotch filter."
                                }
