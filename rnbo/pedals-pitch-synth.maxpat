                                                                        "text": "Clock output: holds when peaks are equal, passes when different",
                                                                        "linecount": 4,
                                                                        "patching_rect": [ 130.0, 500.0, 110.0, 60.0 ],
                                                                        "background": 1,
                                                                        "numinlets": 1,
