                                    "id": "obj-12",
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 862.0, 36.0, 149.0, 21.0 ],
                                    "text": "Classic stereo pitch shifter"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontface": 1,
                                    "fontsize": 18.0,
                                    "id": "obj-15",
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 700.0, 30.0, 160.0, 28.0 ],
                                    "text": "RNBO PitchShifter"
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
                                    "id": "obj-94",
                                    "linecount": 5,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 500.0, 50.0, 180.0, 78.0 ],
                                    "text": "Adjusts a quality factor in terms of time window. As the value is increased, transposition quality increases accordingly, at the cost of an increasing latency."
                                }
                            },
                            {
                                "box": {
                                    "background": 1,
