                                            {
                                                "box": {
                                                    "background": 1,
                                                    "id": "obj-56",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 240.0, 30.0, 565.0, 21.0 ],
                                                    "text": "An 8-voice sound generator that takes advantage of the simple patcher polyphony mechanism of rnbo~"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "background": 1,
                                                    "fontname": "Lato Bold",
                                                    "id": "obj-51",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 170.0, 30.0, 65.0, 21.0 ],
                                                    "text": "Oscillators"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "background": 1,
                                                    "id": "obj-48",
                                                    "linecount": 10,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 70.0, 412.0, 150.0 ],
                                                    "text": "This synth can play up to 4 octaves simultaneously, and each octave has two audio channels. Each audio channel must be controlled separately, therefore we need 8 oscillator voices. Voices from 1 to 4 feed the left channel, voices from 5 to 8 feed the right channel. The polyphony is defined by the @polyphony attribute for a given subpatcher. In this example, the Osc~ subpatcher - which contains the sound generators - is copied 8 times (@polyphony 8 attribute), and each copy can be accessed via a voice number defined through the <set target> object. Glide and timbre parameters are sent to all voices (target 0), while octave transpositions, detuning and spread are distributed to each block of 4 voices. "
                                                }
                                            },
                                            {
                                                "box": {
                                                    "background": 1,
                                                    "id": "obj-39",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 240.0, 760.0, 108.0, 21.0 ],
                                                    "text": "-12 dB attenuation"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "background": 1,
                                                    "bubble": 1,
                                                    "bubblepoint": 0.0,
                                                    "bubbleside": 0,
                                                    "fontface": 0,
                                                    "fontsize": 10.0,
                                                    "id": "obj-30",
                                                    "linecount": 2,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 480.0, 750.0, 110.0, 49.0 ],
                                                    "saved_attribute_attributes": {
                                                        "bubble_bgcolor": {
                                                            "expression": "themecolor.theme_locked_bgcolor"
                                                        }
                                                    },
                                                    "text": "Double-click to see the embedded patch",
                                                    "textjustification": 1
                                                }
                                            },
