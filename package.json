{
	"name": "ambient-circuit",
	"version": "0.0.17",
	"dependencies": {
		"@dimforge/rapier3d-compat": "^0.19.3",
		"@rnbo/js": "^1.4.2",
		"@theatre/core": "^0.7.2",
		"@threlte/core": "^8.4.1",
		"@threlte/extras": "^9.7.1",
		"@threlte/rapier": "^3.2.0",
		"@threlte/theatre": "^3.1.2",
		"@tonaljs/chord-detect": "^4.9.1",
		"@tonaljs/scale": "^4.13.4",
		"buffer": "^6.0.3",
		"culori": "^4.0.2",
		"debug": "^4.4.3",
		"maath": "^0.10.8",
		"pako": "^2.1.0",
		"rambdax": "^11.3.1",
		"svelte-tweakpane-ui": "^1.5.14",
		"three": "^0.183.2",
		"tone": "^15.1.22",
		"tsl-textures": "^3.0.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@theatre/studio": "^0.7.2",
		"@types/culori": "^4.0.1",
		"@types/debug": "^4.1.12",
		"@types/eslint": "^9.6.0",
		"@types/opentype.js": "^1.3.9",
		"@types/pako": "^2.0.4",
		"@types/three": "^0.183.1",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-sonarjs": "^4.0.0",
		"eslint-plugin-svelte": "^3.14.0",
		"eslint-plugin-unicorn": "^63.0.0",
		"globals": "^17.3.0",
		"opentype.js": "^1.3.4",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.4.1",
		"puppeteer-core": "^23.11.1",
		"svelte": "5.53.7",
		"svelte-check": "^4.4.5",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "npm version patch --no-git-tag-version && vite build",
		"format": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"heap": "node scripts/heap-snapshot.js",
		"heap:play": "node scripts/heap-snapshot.js --url=http://localhost:5173/#scene-rings --no-headless --wait=30",
		"heap:play:tone": "node scripts/heap-snapshot.js --url=http://localhost:5173/#scene-tone-instruments --no-headless --wait=30",
		"heap:play:preview": "node scripts/heap-snapshot.js --url=http://localhost:4173/#scene-rings --no-headless --type=preview --switching --wait=30",
		"gen:architecture": "npx tsx scripts/architecture.ts",
		"gen:patchers": "node scripts/patchers.js",
		"gen:sample": "npx tsx scripts/sample-meta.ts && npx tsx scripts/samples.ts && prettier --write ./src/lib/audio/samples.ts",
		"gen:svg-paths": "npx tsx scripts/svg-paths.ts",
		"postinstall": "node -e \"const fs=require('fs'),f='node_modules/@types/three/src/cameras/Camera.d.ts',c=fs.readFileSync(f,'utf8');fs.writeFileSync(f,c.replace('readonly isCamera: boolean','readonly isCamera: true'))\"",
		"preview": "vite preview",
		"test": "vitest"
	},
	"sideEffects": false,
	"type": "module"
}
