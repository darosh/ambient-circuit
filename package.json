{
	"name": "ambient-circuit",
	"version": "0.0.3",
	"dependencies": {
		"@dimforge/rapier3d-compat": "^0.19.3",
		"@rnbo/js": "^1.4.2",
		"@theatre/core": "^0.7.2",
		"@threlte/core": "^8.3.1",
		"@threlte/extras": "^9.7.1",
		"@threlte/rapier": "^3.2.0",
		"@threlte/theatre": "^3.1.2",
		"@tonaljs/chord-detect": "^4.9.1",
		"@tonaljs/scale": "^4.13.4",
		"debug": "^4.4.3",
		"maath": "^0.10.8",
		"rambdax": "^11.3.1",
		"svelte-tweakpane-ui": "^1.5.14",
		"three": "^0.182.0",
		"tone": "^15.1.22"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@theatre/studio": "^0.7.2",
		"@types/debug": "^4.1.12",
		"@types/eslint": "^9.6.0",
		"@types/opentype.js": "^1.3.9",
		"@types/three": "^0.182.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"opentype.js": "^1.3.4",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.4.1",
		"puppeteer-core": "^23.11.1",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"bump": "npm version patch --no-git-tag-version",
		"build": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"preview": "vite preview",
		"heap": "node scripts/heap-snapshot.js",
		"heap:play": "node scripts/heap-snapshot.js --url=http://localhost:5173/#scene-rings --no-headless --wait=30",
		"heap:play:tone": "node scripts/heap-snapshot.js --url=http://localhost:5173/#scene-tone-instruments --no-headless --wait=30",
		"heap:play:preview": "node scripts/heap-snapshot.js --url=http://localhost:4173/#scene-rings --no-headless --type=preview --switching --wait=30",
		"test": "vitest"
	},
	"sideEffects": false,
	"type": "module"
}
